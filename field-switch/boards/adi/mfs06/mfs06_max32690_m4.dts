/*
 * MFS — field switch. MAX32690 + ADIN6310.
 *
 * NO es la misma placa que el power switch (MPS-04P), aunque el hardware se
 * parezca y ambas lleven MAX32690 + ADIN6310. Diferencias que importan aqui:
 *
 *   |                 | MFS (esta)            | MPS-04P               |
 *   |-----------------|-----------------------|-----------------------|
 *   | Slots SPE       | 6                     | 4 (J3-J6 = Port 1-4)  |
 *   | RJ45            | no                    | si (Port 5, ADIN1300) |
 *   | Uplink a la TPU | PDM en el slot Port 1 | LAN7431 -> PCIe       |
 *   | Puertos PSE     | 5 (slots Port 2-6)    | 4 (LTC port0-3)       |
 *
 * Las dos compartian esta definicion de placa bajo el nombre `adin6310t1l`,
 * con un solo directorio en el arbol de Zephyr: quien lo editaba ultimo
 * mandaba para ambas compilaciones. Separadas el 2026-07-29.
 *
 * ⚠️ Aqui SOLO se declaran port0-port3 del LTC4296, igual que antes de
 * separar las placas. El MFS necesita un quinto (`port4` = slot Port 6,
 * lineas SCCP en P2.23/P2.24), pero anadirlo dejo la imagen SIN ARRANCAR
 * (PC en ROM, ni PSE ni switch) -- ver FLASHEO.md §6. Este fichero conserva
 * el estado que SI arranca; tener la placa separada es justo lo que permite
 * reintentarlo sin arriesgar al MPS. Al reintentar, bisecar y leer el PC
 * tras el POR antes de dar nada por bueno.
 */

/dts-v1/;

#include <adi/max32/max32690.dtsi>
#include <adi/max32/max32690-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/adi-max32-gpio.h>
#include <zephyr/dt-bindings/sensor/ltc4296.h>

/ {
	model = "Analog Devices ADIN6310 Ethernet Switch";
	compatible = "adi,adin6310switch";

	soc {
		sram_all: memory@20020000 {
			compatible = "mmio-sram";
			reg = <0x20020000 DT_SIZE_K(1024)>;
		};
	};

	chosen {
		zephyr,console = &uart3;
		zephyr,shell-uart = &uart3;
		zephyr,sram = &sram_all;
		zephyr,flash = &flash0;
	};

	leds {
		compatible = "gpio-leds";
		blue_led: led_0 {
			gpios = <&gpio2 1 GPIO_ACTIVE_HIGH>;
			label = "LED1";
		};
		green_led: led_1 {
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
			label = "LED2";
		};
		red_led: led_2 {
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
			label = "LED3";
		};
	};

	buttons {
		compatible = "gpio-keys";
		pb0: pb0 {
			gpios = <&gpio1 27 GPIO_ACTIVE_HIGH>;
			label = "USR_PBTN";
		};
	};

	aliases {
		led0 = &blue_led;
		led1 = &green_led;
		led2 = &red_led;
		sw0 = &pb0;
	 };
};

&clk_ipo {
	status = "okay";
};

/*
 * ERTCO requires for RTC
 */
&clk_ertco {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&uart3 {
	pinctrl-0 = <&lpuart0b_tx_p3_1 &lpuart0b_rx_p3_0>;
	pinctrl-names = "default";
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	status = "okay";
};

&uart2 {
	pinctrl-0 = <&uart2a_tx_p1_10 &uart2a_rx_p1_9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	status = "okay";
};

&uart1 {
	pinctrl-0 = <&uart1a_tx_p2_16 &uart1a_rx_p2_14>;
	pinctrl-names = "default";
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	status = "okay";
};

&i2c0 {
	pinctrl-0 = <&i2c0a_scl_p2_8 &i2c0a_sda_p2_7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

&i2c2 {
	pinctrl-0 = <&i2c2c_scl_p1_8 &i2c2c_sda_p1_7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

&spi0b_ss1_p2_26 {
	power-source = <MAX32_VSEL_VDDIOH>;
};
&spi0b_miso_p2_27 {
	power-source = <MAX32_VSEL_VDDIOH>;
};
&spi0b_mosi_p2_28 {
	power-source = <MAX32_VSEL_VDDIOH>;
};
&spi0b_ss1_p2_26 {
	power-source = <MAX32_VSEL_VDDIOH>;
};
&spi0b_sck_p2_29 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi4a_ss0_p1_0 {
	power-source = <MAX32_VSEL_VDDIO>;
};

&spi4a_mosi_p1_1 {
	power-source = <MAX32_VSEL_VDDIO>;
};

&spi4a_miso_p1_2 {
	power-source = <MAX32_VSEL_VDDIO>;
};

&spi4a_sck_p1_3 {
	power-source = <MAX32_VSEL_VDDIO>;
};

&spi4a_sdio2_p1_4 {
	power-source = <MAX32_VSEL_VDDIO>;
};

&spi4a_sdio3_p1_5 {
	power-source = <MAX32_VSEL_VDDIO>;
};

&spi0 {
	pinctrl-0 = <&spi0b_ss1_p2_26 &spi0b_miso_p2_27
			&spi0b_mosi_p2_28 &spi0b_sck_p2_29>;
	pinctrl-names = "default";
	status = "okay";
	ltc4296: ltc4296@1 {
		compatible = "adi,ltc4296";
		zephyr,deferred-init;
		spi-max-frequency = <500000>;
		reg = <0x1>;

		port0 {
			sccpi-gpios = <&gpio2 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP | MAX32_GPIO_VSEL_VDDIOH)>;
			sccpo-gpios = <&gpio2 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP | MAX32_GPIO_VSEL_VDDIOH)>;
			adi,power-class = <LTC4296_PSE>;
			adi,hs-resistor = <250>;
		};

		port1 {
			sccpi-gpios = <&gpio2 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP | MAX32_GPIO_VSEL_VDDIOH)>;
			sccpo-gpios = <&gpio2 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP | MAX32_GPIO_VSEL_VDDIOH)>;
			adi,power-class = <LTC4296_PSE>;
			adi,hs-resistor = <250>;
		};

		port2 {
			sccpi-gpios = <&gpio2 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP | MAX32_GPIO_VSEL_VDDIOH)>;
			sccpo-gpios = <&gpio2 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP | MAX32_GPIO_VSEL_VDDIOH)>;
			adi,power-class = <LTC4296_PSE>;
			adi,hs-resistor = <250>;
		};

		port3 {
			sccpi-gpios = <&gpio2 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP | MAX32_GPIO_VSEL_VDDIOH)>;
			sccpo-gpios = <&gpio2 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP | MAX32_GPIO_VSEL_VDDIOH)>;
			adi,power-class = <LTC4296_PSE>;
			adi,hs-resistor = <250>;
		};
	};
};

&spi1 {
	pinctrl-0 = <&spi1a_ss0_p1_23 &spi1a_miso_p1_28
				&spi1a_mosi_p1_29 &spi1a_sck_p1_26>;
};

&spi3 {
	pinctrl-0 = <&spi3a_ss0_p0_19 &spi3a_miso_p0_20
				&spi3a_mosi_p0_21 &spi3a_sck_p0_16>;
};

&spi4 {
	pinctrl-0 = <&spi4a_ss0_p1_0 &spi4a_miso_p1_2
		     &spi4a_mosi_p1_1 &spi4a_sck_p1_3>;

	pinctrl-names = "default";
	status = "okay";

	adin6310: adin6310@0 {
		compatible = "adi,adin6310";
		reg = <0x0>;
		spi-max-frequency = <1000000>;
		int-gpios = <&gpio1 7 (GPIO_ACTIVE_HIGH | MAX32_GPIO_VSEL_VDDIO)>;
		reset-gpios = <&gpio1 8 (GPIO_ACTIVE_LOW | MAX32_GPIO_VSEL_VDDIO)>;
		cfg-gpios = <&gpio1 23 (GPIO_ACTIVE_HIGH | MAX32_GPIO_VSEL_VDDIOH)>,
			    <&gpio1 24 (GPIO_ACTIVE_HIGH | MAX32_GPIO_VSEL_VDDIOH)>,
			    <&gpio1 25 (GPIO_ACTIVE_HIGH | MAX32_GPIO_VSEL_VDDIOH)>,
			    <&gpio1 26 (GPIO_ACTIVE_HIGH | MAX32_GPIO_VSEL_VDDIOH)>;

		port0 {
			cpu-port;
			local-mac-address = [ 00 18 80 03 25 60 ];
			phy-connection-type = "rgmii";
		};
		port1 {
			local-mac-address = [ 00 18 80 03 25 61 ];
			phy-connection-type = "rmii";
		};
		port2 {
			local-mac-address = [ 00 18 80 03 25 62 ];
			phy-connection-type = "rmii";
		};
		port3 {
			local-mac-address = [ 00 18 80 03 25 63 ];
			phy-connection-type = "rmii";
		};
		port4 {
			local-mac-address = [ 00 18 80 03 25 64 ];
			phy-connection-type = "rmii";
		};
		port5 {
			local-mac-address = [ 00 18 80 03 25 65 ];
			phy-connection-type = "rmii";
		};

		mdio {
			compatible = "adi,adin6310-mdio";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			phy0: ethernet-phy@0 {
				reg = <0x0>;
				compatible = "adi,adin1100-phy";
				status = "okay";
			};
			phy1: ethernet-phy@1 {
				reg = <0x1>;
				compatible = "adi,adin1100-phy";
				status = "okay";
			};
			phy3: ethernet-phy@6 {
				reg = <0x6>;
				compatible = "ethernet-phy";
				status = "okay";
			};
			phy4: ethernet-phy@5 {
				reg = <0x5>;
				compatible = "ethernet-phy";
				status = "okay";
			};
			phy5: ethernet-phy@2 {
				reg = <0x2>;
				compatible = "adi,adin1100-phy";
				status = "okay";
			};
			phy6: ethernet-phy@3 {
				reg = <0x3>;
				compatible = "adi,adin1100-phy";
				status = "okay";
			};
		};
	};
};
