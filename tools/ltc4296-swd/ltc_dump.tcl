proc ltcread {reg pecb name} {
  mww 0x40046008 0x00050005
  mww 0x4004601C 0xC000C0
  mww 0x40046020 0xFFFFFFFF
  mwb 0x40046000 [expr {($reg << 1) | 1}]
  mwb 0x40046000 $pecb
  mwb 0x40046000 0
  mwb 0x40046000 0
  mwb 0x40046000 0
  set c [lindex [read_memory 0x40046004 32 1] 0]
  mww 0x40046004 [expr {($c & ~0xF0000) | 0x20000 | 0x20 | 0x1}]
  sleep 3
  set d [read_memory 0x40046000 8 5]
  echo [format "%s = %02x%02x" $name [lindex $d 2] [lindex $d 3]]
}
init
halt
ltcread 0x02 0xdb GFLTEV
ltcread 0x07 0xed GIOST
ltcread 0x08 0xb7 GCMD
ltcread 0x09 0xb9 GCFG
ltcread 0x0a 0xab GADCCFG
ltcread 0x0b 0xa5 GADCDAT
ltcread 0x30 0xe0 P2EV
ltcread 0x32 0xfc P2ST
ltcread 0x33 0xf2 P2CFG0
ltcread 0x34 0xd8 P2CFG1
ltcread 0x10 0x27 P0EV
ltcread 0x12 0x3b P0ST
ltcread 0x13 0x35 P0CFG0
ltcread 0x20 0x00 P1EV
ltcread 0x22 0x1c P1ST
ltcread 0x23 0x12 P1CFG0
ltcread 0x40 0x4e P3EV
ltcread 0x42 0x52 P3ST
ltcread 0x43 0x5c P3CFG0
resume
shutdown