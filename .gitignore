# Credenciales -- NUNCA versionar
tools/provision.env
*.env
!*.env.example

# Artefactos de build de Zephyr
build/
*.o
*.obj

# Binarios de firmware (se generan; los firmados van por release)
*.bin
*.sbin
*.sig
*.elf
*.map

# Artefactos de la maquina de build
tpu-artifacts/

# Claves del equipo, nunca versionar
tpu/varec-gateway/secrets.env

# Firmware prebuilt del field switch (entregable con el fix de ERTCO) - SI versionar
!field-switch/prebuilt/
!field-switch/prebuilt/*.sbin
!field-switch/prebuilt/*.bin

# Firmware prebuilt del power switch (config segura LTC4296) - SI versionar
!power-switch/prebuilt/
!power-switch/prebuilt/*.sbin
!power-switch/prebuilt/*.bin
